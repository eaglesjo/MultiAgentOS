{
  "name": "agent-execution-runtime-vscode",
  "displayName": "Agent Execution Runtime",
  "description": "VS Code adapter for the Agent Execution Runtime local development runtime.",
  "version": "0.1.0",
  "publisher": "eaglesjo",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "agentExecutionRuntime.showContext", "title": "Agent Execution Runtime: Show Context" },
      { "command": "agentExecutionRuntime.sendSelection", "title": "Agent Execution Runtime: Send Selection" }
    ],
    "configuration": {
      "title": "Agent Execution Runtime",
      "properties": {
        "agentExecutionRuntime.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Loopback-only Agent Execution Runtime bridge endpoint."
        },
        "agentExecutionRuntime.token": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token for the local Agent Execution Runtime bridge.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "tsc --noEmit -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0"
  }
}