    <description>Android Studio adapter for the Agent Execution Runtime development runtime.</description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <projectManagerListener implementation="io.multiagentos.agentexecutionruntime.AgentExecutionRuntimeProjectActivityListener"/>
    </extensions>
</idea-plugin>
